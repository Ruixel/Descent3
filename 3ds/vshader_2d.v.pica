; 2D textured quad vertex shader for Descent 3 / 3DS
; Inputs:
;   v0 = position (x, y in clip space [-1..1], z, w)
;   v1 = texcoord (s, t, 0, 0)
;   v2 = colour   (r, g, b, a)
; Outputs:
;   outpos   = clip-space position
;   outtex   = texcoord0
;   outcolor = primary color (passed to TEV)

.fvec projection[4]

.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias zeros myconst.xxxx
.alias ones  myconst.yyyy

.out outpos   position
.out outtex   texcoord0
.out outcolor color

.in inpos   v0
.in intex   v1
.in incolor v2

.entry vmain
.proc vmain
    ; Transform position: projection * input position
    mov r0.xyz, inpos
    mov r0.w,   ones

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; Pass texcoord through, zero out zw
    mov outtex.xy, intex.xy
    mov outtex.zw, zeros

    ; Pass colour through
    mov outcolor, incolor

    end
.end
